source "https://rubygems.org"

# ใช้สำหรับดูเว็บในเครื่องก่อน push เท่านั้น
# GitHub Pages ไม่ได้ใช้ไฟล์นี้ในการ build (มันใช้ชุด gem ของตัวเอง)
#
#   bundle install
#   bundle exec jekyll serve
#   เปิด http://localhost:4000/dungeons-and-dragons/
gem "github-pages", group: :jekyll_plugins
gem "webrick"
